package models.flipnfind;

// Paths of the Flip n Find assets. They are in their own flipnfind folders and start with fnf_
// so they never clash with the files of the other games (AssetPaths needs unique file names).
class GameAssets
{
	public static inline var BACKGROUND = "assets/images/flipnfind/fnf_background.png";
	public static inline var CARDS = "assets/images/flipnfind/fnf_cards.png";
	public static inline var HOME = "assets/images/flipnfind/fnf_home.png";
	public static inline var INFO = "assets/images/flipnfind/fnf_info.png";

	public static inline var MUSIC = "assets/music/flipnfind/fnf_theme.ogg";

	public static inline var CLICK = "assets/sounds/flipnfind/fnf_click.ogg";
	public static inline var FLIP = "assets/sounds/flipnfind/fnf_flip.ogg";
	public static inline var MATCH = "assets/sounds/flipnfind/fnf_match.ogg";
	public static inline var MISS = "assets/sounds/flipnfind/fnf_miss.ogg";
	public static inline var WIN = "assets/sounds/flipnfind/fnf_win.ogg";
	public static inline var LOSE = "assets/sounds/flipnfind/fnf_lose.ogg";
}
